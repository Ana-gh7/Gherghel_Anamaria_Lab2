@page "/"
@model Gherghel_Anamaria_Lab2.Pages.BookPages.IndexModel

@{
    ViewData["Title"] = "Books";
}

<h1>Books</h1>

<p>
    <a asp-page="./Create">Create New</a>
</p>


<form>
    <p>
        Search:
        <input type="text" name="searchString" value="@Model.CurrentFilter" />
        <input type="submit" value="Search" />
        <a asp-page="./Index">Back to full List</a>
    </p>
</form>


<table class="table">
    <thead>
        <tr>

          
            <th>
                <a asp-page="./Index"
                   asp-route-sortOrder="@Model.TitleSort"
                   asp-route-searchString="@Model.CurrentFilter">
                    Title
                </a>
            </th>
            <th>
                <a asp-page="./Index"
                   asp-route-sortOrder="@Model.AuthorSort"
                   asp-route-searchString="@Model.CurrentFilter">
                    Author
                </a>
            </th>

  
            <th>Price</th>
            <th>Publisher</th>
            <th>BookCategories</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.BookD.Books)
        {
            <tr>
                <td>@item.Title</td>
                <td>
                    @item.Authors?.FirstName @item.Authors?.LastName
                </td>
                <td>@item.Price</td>
                <td>@item.Publisher?.PublisherName</td>
                <td>
                    @foreach (var category in item.BookCategories)
                    {
                        <div>
                            @category.Category?.ID @category.Category?.CategoryName
                        </div>
                    }
                </td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@item.ID">Edit</a> |
                    <a asp-page="./Details" asp-route-id="@item.ID">Details</a> |
                    <a asp-page="./Delete" asp-route-id="@item.ID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
